+// xiaoke-context-command: serve usage without a Claude turn or another bot poller.
+bot.command('context', async ctx => {
+  const gated = dmCommandGate(ctx)
+  if (!gated || !gated.access.allowFrom.includes(gated.senderId)) return
+
+  const python = join(homedir(), 'xiaoke', '.venv', 'bin', 'python')
+  const helper = join(homedir(), 'xiaoke', 'deploy', 'telegram_context.py')
+  try {
+    const message = await new Promise<string>((resolve, reject) => {
+      execFile(python, [helper], { encoding: 'utf8', timeout: 6000, maxBuffer: 8192 },
+        (error, stdout) => error ? reject(error) : resolve(stdout.trim()))
+    })
+    await ctx.reply(message || '上下文用量暂时不可用。')
+  } catch {
+    await ctx.reply('上下文用量暂时不可用，请稍后重试。')
+  }
+})
